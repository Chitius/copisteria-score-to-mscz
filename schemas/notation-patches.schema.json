{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/copisteria-score-to-mscz/notation-patches.schema.json",
  "title": "copisteria-score-to-mscz notation patches",
  "type": "object",
  "required": ["patches"],
  "properties": {
    "patches": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/clef-patch"},
          {"$ref": "#/$defs/ottava-patch"},
          {"$ref": "#/$defs/pedal-patch"},
          {"$ref": "#/$defs/wedge-patch"},
          {"$ref": "#/$defs/dynamic-patch"},
          {"$ref": "#/$defs/repeat-patch"},
          {"$ref": "#/$defs/volta-patch"},
          {"$ref": "#/$defs/fermata-patch"},
          {"$ref": "#/$defs/navigation-patch"},
          {"$ref": "#/$defs/ornament-patch"},
          {"$ref": "#/$defs/glissando-patch"},
          {"$ref": "#/$defs/arpeggio-patch"},
          {"$ref": "#/$defs/parentheses-patch"},
          {"$ref": "#/$defs/tuplet-patch"}
        ]
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": ["measure", "beat"],
      "properties": {
        "measure": {"type": "integer", "minimum": 1},
        "beat": {"type": "number", "minimum": 0}
      }
    },
    "note-anchor": {
      "allOf": [
        {"$ref": "#/$defs/anchor"},
        {
          "type": "object",
          "required": ["pitch"],
          "properties": {"pitch": {"type": "string", "minLength": 2}}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["page", "evidence"],
      "anyOf": [{"required": ["bbox"]}, {"required": ["crop"]}],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "bbox_space": {"enum": ["pdf-points", "image-px"]},
        "crop": {"type": "string"},
        "evidence": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "clef-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "staff", "clef", "line", "status"],
          "properties": {
            "op": {"const": "clef"},
            "part": {"type": "string", "minLength": 1},
            "measure": {"type": "integer", "minimum": 1},
            "staff": {"type": "integer", "minimum": 1},
            "clef": {"enum": ["G", "F", "C"]},
            "line": {"type": "integer", "minimum": 1, "maximum": 5},
            "from_measure": {
              "type": "integer",
              "minimum": 1,
              "description": "measure carrying the superseded clef to retire"
            },
            "status": {"const": "accepted"}
          }
        }
      ]
    },
    "ottava-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "subtype", "staff", "start", "end"],
          "properties": {
            "op": {"const": "ottava"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "subtype": {"enum": ["8va", "8vb"]},
            "staff": {"type": "integer", "minimum": 1},
            "start": {"$ref": "#/$defs/anchor"},
            "end": {"$ref": "#/$defs/anchor"}
          }
        }
      ]
    },
    "pedal-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "staff", "start", "end"],
          "properties": {
            "op": {"const": "pedal"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "staff": {"type": "integer", "minimum": 1},
            "placement": {"enum": ["above", "below"]},
            "line": {"type": "boolean"},
            "start": {"$ref": "#/$defs/anchor"},
            "end": {"$ref": "#/$defs/anchor"},
            "changes": {
              "type": "array",
              "items": {"$ref": "#/$defs/anchor"}
            }
          }
        }
      ]
    },
    "wedge-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "subtype", "staff", "start", "end"],
          "properties": {
            "op": {"const": "wedge"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "subtype": {"enum": ["crescendo", "diminuendo"]},
            "staff": {"type": "integer", "minimum": 1},
            "placement": {"enum": ["above", "below"]},
            "niente": {"type": "boolean"},
            "start": {"$ref": "#/$defs/anchor"},
            "end": {"$ref": "#/$defs/anchor"}
          }
        }
      ]
    },
    "dynamic-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "beat", "staff", "mark"],
          "properties": {
            "op": {"const": "dynamic"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "measure": {"type": "integer", "minimum": 1},
            "beat": {"type": "number", "minimum": 0},
            "staff": {"type": "integer", "minimum": 1},
            "placement": {"enum": ["above", "below"]},
            "mark": {
              "enum": [
                "p", "pp", "ppp", "pppp", "ppppp", "pppppp",
                "f", "ff", "fff", "ffff", "fffff", "ffffff",
                "mp", "mf",
                "sf", "sfp", "sfpp", "fp", "rf", "rfz", "sfz", "sffz", "fz", "n", "pf", "sfzp"
              ]
            }
          }
        }
      ]
    },
    "repeat-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "direction"],
          "properties": {
            "op": {"const": "repeat"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "measure": {"type": "integer", "minimum": 1},
            "direction": {"enum": ["forward", "backward"]},
            "times": {"type": "integer", "minimum": 2}
          }
        }
      ]
    },
    "volta-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "start_measure", "end_measure", "number"],
          "properties": {
            "op": {"const": "volta"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "start_measure": {"type": "integer", "minimum": 1},
            "end_measure": {"type": "integer", "minimum": 1},
            "number": {"type": "string", "pattern": "^\\d+(?:\\s*,\\s*\\d+)*$"},
            "stop_type": {"enum": ["stop", "discontinue"]},
            "text": {"type": "string"}
          }
        }
      ]
    },
    "fermata-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "beat", "staff"],
          "properties": {
            "op": {"const": "fermata"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "measure": {"type": "integer", "minimum": 1},
            "beat": {"type": "number", "minimum": 0},
            "staff": {"type": "integer", "minimum": 1},
            "voice": {"type": "string", "minLength": 1},
            "type": {"enum": ["upright", "inverted"]},
            "shape": {"enum": ["normal", "angled", "square"]}
          }
        }
      ]
    },
    "navigation-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "beat", "staff", "mark"],
          "properties": {
            "op": {"const": "navigation"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "measure": {"type": "integer", "minimum": 1},
            "beat": {"type": "number", "minimum": 0},
            "staff": {"type": "integer", "minimum": 1},
            "placement": {"enum": ["above", "below"]},
            "mark": {"enum": ["segno", "coda"]}
          }
        }
      ]
    },
    "ornament-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "beat", "staff", "kind"],
          "properties": {
            "op": {"const": "ornament"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "measure": {"type": "integer", "minimum": 1},
            "beat": {"type": "number", "minimum": 0},
            "staff": {"type": "integer", "minimum": 1},
            "voice": {"type": "string", "minLength": 1},
            "placement": {"enum": ["above", "below"]},
            "kind": {
              "enum": [
                "trill",
                "mordent",
                "inverted-mordent",
                "turn",
                "inverted-turn",
                "delayed-turn",
                "tremolo"
              ]
            },
            "slashes": {"type": "integer", "minimum": 1, "maximum": 5}
          }
        }
      ]
    },
    "glissando-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "staff", "start", "end"],
          "properties": {
            "op": {"const": "glissando"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "staff": {"type": "integer", "minimum": 1},
            "voice": {"type": "string", "minLength": 1},
            "line_type": {"enum": ["wavy", "solid", "dashed", "dotted"]},
            "text": {"type": "string"},
            "start": {"$ref": "#/$defs/anchor"},
            "end": {"$ref": "#/$defs/anchor"}
          }
        }
      ]
    },
    "arpeggio-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "beat"],
          "anyOf": [{"required": ["staff"]}, {"required": ["staves"]}],
          "properties": {
            "op": {"const": "arpeggio"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "replace", "remove"]},
            "measure": {"type": "integer", "minimum": 1},
            "beat": {"type": "number", "minimum": 0},
            "staff": {"type": "integer", "minimum": 1},
            "staves": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "minItems": 1,
              "uniqueItems": true
            },
            "voice": {"type": "string", "minLength": 1},
            "kind": {"enum": ["arpeggiate", "non-arpeggiate"]},
            "direction": {"enum": ["none", "up", "down"]}
          }
        }
      ]
    },
    "parentheses-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": ["op", "measure", "beat", "staff", "pitch"],
          "properties": {
            "op": {"const": "parentheses"},
            "part": {"type": "string", "minLength": 1},
            "mode": {"enum": ["add", "remove"]},
            "measure": {"type": "integer", "minimum": 1},
            "beat": {"type": "number", "minimum": 0},
            "staff": {"type": "integer", "minimum": 1},
            "voice": {"type": "string", "minLength": 1},
            "pitch": {"type": "string", "minLength": 2},
            "target": {"enum": ["notehead", "accidental", "both"]}
          }
        }
      ]
    },
    "tuplet-patch": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {
          "type": "object",
          "required": [
            "op", "measure", "staff", "voice", "start", "end",
            "actual_notes", "normal_notes", "note_count", "span_beats", "status"
          ],
          "properties": {
            "op": {"const": "tuplet"},
            "part": {"type": "string", "minLength": 1},
            "measure": {"type": "integer", "minimum": 1},
            "staff": {"type": "integer", "minimum": 1},
            "voice": {"type": "string", "minLength": 1},
            "start": {"$ref": "#/$defs/note-anchor"},
            "end": {"$ref": "#/$defs/note-anchor"},
            "actual_notes": {"type": "integer", "minimum": 1},
            "normal_notes": {"type": "integer", "minimum": 1},
            "note_count": {"type": "integer", "minimum": 1},
            "span_beats": {"type": "number", "exclusiveMinimum": 0},
            "status": {"const": "accepted"}
          }
        }
      ]
    }
  }
}
