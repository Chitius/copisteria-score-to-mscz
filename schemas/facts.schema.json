{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/copisteria-score-to-mscz/facts.schema.json",
  "title": "copisteria-score-to-mscz facts",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "pages": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "pdf_sha256": {"type": "string", "minLength": 1}
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "additionalProperties": true,
        "properties": {
          "type": {"type": "string", "enum": ["title", "subtitle", "composer", "arranger", "transcriber", "lyricist"]},
          "text": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "bbox_space": {"type": "string", "enum": ["pdf-points", "image-px"]},
          "crop": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measure"],
        "additionalProperties": true,
        "properties": {
          "part": {"type": "string", "minLength": 1},
          "measure": {"type": "integer", "minimum": 1},
          "beat": {"type": "number", "minimum": 0},
          "placement": {"type": "string", "enum": ["above", "below"]},
          "text": {"type": "string"},
          "rehearsal": {"type": "string"},
          "tempo": {"type": "number", "exclusiveMinimum": 0},
          "metronome": {"type": "number", "exclusiveMinimum": 0},
          "gradual": {
            "type": "string",
            "enum": ["ritardando", "rallentando", "accelerando", "stringendo", "allargando"],
            "description": "a gradual tempo word that becomes a GradualTempoChange spanner"
          },
          "length_measures": {"type": "integer", "minimum": 1},
          "length_fractions": {"type": "string", "pattern": "^-?(\\d+/\\d+)?$"},
          "beat_unit": {"type": "string", "enum": ["whole", "half", "quarter", "eighth", "16th", "32nd"]},
          "italic": {"type": "boolean"},
          "font_size": {"type": "number"},
          "justify": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "bbox_space": {"type": "string", "enum": ["pdf-points", "image-px"]},
          "crop": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "anyOf": [
          {"required": ["text"]},
          {"required": ["rehearsal"]},
          {"required": ["tempo"]},
          {"required": ["metronome"]}
        ]
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["part"],
        "additionalProperties": true,
        "properties": {
          "part": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "abbreviation": {"type": "string", "minLength": 1},
          "instrument": {
            "type": "string",
            "enum": [
              "accordion",
              "acoustic-bass",
              "acoustic-guitar",
              "alto",
              "alto-sax",
              "baritone",
              "baritone-sax",
              "bass-voice",
              "bassoon",
              "cello",
              "choir",
              "clarinet",
              "contrabass",
              "drumset",
              "electric-bass",
              "electric-guitar",
              "electric-guitar-distortion",
              "electric-guitar-overdrive",
              "electric-piano",
              "flute",
              "harp",
              "harpsichord",
              "horn",
              "mezzo-soprano",
              "nylon-guitar",
              "oboe",
              "organ",
              "percussion",
              "piano",
              "piccolo",
              "soprano",
              "soprano-sax",
              "strings",
              "synth-lead",
              "synth-pad",
              "tenor",
              "tenor-sax",
              "trombone",
              "trumpet",
              "tuba",
              "viola",
              "violin",
              "voice"
            ]
          },
          "sound": {"type": "string", "minLength": 1},
          "midi_program": {"type": "integer", "minimum": 1, "maximum": 128},
          "midi_channel": {"type": "integer", "minimum": 1, "maximum": 16},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "bbox_space": {"type": "string", "enum": ["pdf-points", "image-px"]},
          "crop": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "anyOf": [
          {"required": ["name"]},
          {"required": ["abbreviation"]},
          {"required": ["instrument"]},
          {"required": ["sound"]},
          {"required": ["midi_program"]},
          {"required": ["midi_channel"]}
        ]
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measure", "from", "to"],
        "additionalProperties": true,
        "properties": {
          "part": {"type": "string", "minLength": 1},
          "measure": {"type": "integer", "minimum": 1},
          "beat": {"type": "number", "minimum": 0},
          "staff": {"type": "integer", "minimum": 1},
          "voice": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "string", "minLength": 1}
            ]
          },
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["proposed", "accepted", "rejected"]},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "bbox_space": {"type": "string", "enum": ["pdf-points", "image-px"]},
          "crop": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "anyOf": [
          {"required": ["reason"]},
          {"required": ["note"]}
        ],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "measure": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
